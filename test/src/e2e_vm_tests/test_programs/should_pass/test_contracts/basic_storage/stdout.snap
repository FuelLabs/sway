unwrap_84 should not show never as one of its block arguments

> forc build --path test/src/e2e_vm_tests/test_programs/should_pass/test_contracts/basic_storage --ir final --asm final | filter-fn basic_storage unwrap_84

pub fn unwrap_84(mut self: __ptr { u64, ( () | b256 ) }, mut __ret_value: __ptr b256) -> () {
    local u64 code_
    local u64 other_

    entry(mut self: __ptr { u64, ( () | b256 ) }, mut __ret_value: __ptr b256):
    v3529v1 = const u64 0
    v3530v1 = get_elem_ptr self, __ptr u64, v3529v1
    v3531v1 = get_local __ptr u64, other_
    v3532v1 = const u64 1
    store v3532v1 to v3531v1
    v3534v1 = load v3530v1
    v3535v1 = get_local __ptr u64, other_
    v3536v1 = load v3535v1
    v3537v1 = cmp eq v3534v1 v3536v1
    cbr v3537v1, block0(), block1()

    block0():
    v3539v1 = const u64 1
    v3540v1 = const u64 1
    v3541v1 = get_elem_ptr self, __ptr b256, v3539v1, v3540v1
    mem_copy_val __ret_value, v3541v1
    v3543v1 = const unit ()
    ret () v3543v1

    block1():
    v3545v1 = get_local __ptr u64, code_
    v3546v1 = const u64 0
    store v3546v1 to v3545v1
    v3548v1 = get_local __ptr u64, code_
    v3549v1 = load v3548v1
    revert v3549v1
}




