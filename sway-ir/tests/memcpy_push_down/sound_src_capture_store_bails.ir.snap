script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut __ptr { u64, u64 } slot

        entry(mut flag: bool, mut order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        v5v1 = get_local __ptr __ptr { u64, u64 }, slot
        store order to v5v1
        cbr flag, block_write(), block_join()

        block_write():
        v8v1 = get_local __ptr { u64, u64 }, order_copy
        v9v1 = const u64 1
        v10v1 = get_elem_ptr v8v1, __ptr u64, v9v1
        v11v1 = const u64 42
        store v11v1 to v10v1
        br block_join()

        block_join():
        v14v1 = get_local __ptr { u64, u64 }, order_copy
        v15v1 = call consume_read_only(v14v1)
        ret u64 v15v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
