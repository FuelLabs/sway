// SOUNDNESS: an `asm` operand that takes the destination pointer is treated
// as `MayWrite` and must force materialization before the asm (never
// delegate through it).
//
// Expected:
//   A = entry copy disappears,
//   B = a copy materializes in `block_asm` just before the asm,
//   C = `block_read` delegates to `order`.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_asm(), block_read()

        block_asm():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = asm(r1: v1) -> u64 r1 { // <------------------ B
            movi r1 i7
        }
        br block_join(v2)

        block_read():
        v3 = get_local __ptr { u64, u64 }, order_copy
        v4 = call consume_read_only(v3) // <------------------ C
        br block_join(v4)

        block_join(v5: u64):
        ret u64 v5
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
