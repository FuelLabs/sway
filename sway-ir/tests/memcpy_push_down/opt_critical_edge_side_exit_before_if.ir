// OPT: cold exit before the if, plus a multi_succ_pending_pred on the hot
// arm (critical edge into the join). Forcing block_hot materializes its
// out-state, so O is the singleton { BeforeTerminator(block_hot) }. Fan-out
// is allowed: every successor path still needs dst (write→join and join).
// Cold exit is not a successor of block_hot, so it stays copy-free.
//
// Terms: Glossary in `memcpy_push_down.rs`.
//
// ```sway
// fn main(hot: bool, flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if !hot {
//         return 0;
//     }
//     if flag {
//         order_copy.prev = 42;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// CFG:
//
//               ┌─────────────────┐
//               │      entry      │
//               │ candidate; cbr  │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          ▼                           ▼
// ┌─────────────────┐         ┌─────────────────┐
// │   block_hot     │         │ block_cold_exit │
// │  (cbr flag)     │         │     ret 0       │
// └────────┬────────┘         └─────────────────┘
//          │
//    ┌─────┴─────────────┐
//    ▼                   │  flag == false (empty)
// ┌────────────┐         │  hot → block_join
// │ block_write│         │
// │ store      │         │
// └──────┬─────┘         │
//        └───────┬───────┘
//                ▼
//         ┌─────────────────┐
//         │    block_join   │
//         │ consume(copy)   │
//         └─────────────────┘
//
// Steps:
//
// 1. block_join uses_dst + pending false edge → must_materialize_before_exit
//    on block_hot (multi_succ_pending_pred). Out-state(block_hot)=Materialized,
//    so block_write never records a BeforeInst(store).
// 2. O = { BeforeTerminator(block_hot) }. Coalesce is a no-op (singleton).
// 3. Fan-out OK: every succ of block_hot still needs dst along every exit
//    path. Insert before block_hot's cbr; delete entry candidate.
// 4. cold_exit never runs a copy.
//
// Contrast: `limit_critical_edge_live_join.ir` — entry is already the candidate
// site (`keep_candidate`), so edge_inserts stays empty / IR unchanged.
// Contrast: `opt_hoist_nested_cluster_under_side_exit.ir` — split fallthrough
// yields two sites and coalesce PlaceBefore at block_hot.
//
// Expected:
//   A = entry copy disappears,
//   B = one copy at block_hot before the flag cbr,
//   C = cold_exit has no copy,
//   no copies in block_write.
script {
    entry fn main(hot: bool, flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(hot: bool, flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr hot, block_hot(), block_cold_exit()

        block_hot(): // <------------------ B
        cbr flag, block_write(), block_join()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br block_join()

        block_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6

        block_cold_exit(): // <------------------ C
        v7 = const u64 0
        ret u64 v7
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
