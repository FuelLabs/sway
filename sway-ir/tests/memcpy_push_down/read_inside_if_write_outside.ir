// Corresponding Sway (this hand-written IR mirrors its lowering; the early
// `return` is why the read branch returns directly instead of joining):
//
// ```sway
// script;
//
// struct Order {
//     a: u64,
//     b: u64,
//     c: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Order) -> u64 {
//     order.a
// }
//
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         return consume_read_only(order_copy);
//     }
//     order_copy.prev = 42;
//     consume_read_only(order_copy)
// }
// ```
//
// Inverse of `write_inside_if_read_outside`: here the read happens
// inside the `if` and the write happens outside it, on the fall-through
// path reached while the copy is still pending.
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` disappears,
//   B = `block_read` calls `consume_read_only` on the source argument directly,
//   C = a copy materializes in `block_write`, just before the store.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64, u64, u64 }) -> u64 {
        local mut { u64, u64, u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64, u64, u64 }):
        v0 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_read(), block_write()

        block_read():
        v1 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v2 = call consume_read_only(v1) // <------------------ B
        ret u64 v2

        block_write():
        v3 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v4 = const u64 3
        v5 = get_elem_ptr v3, __ptr u64, v4
        v6 = const u64 42
        store v6 to v5 // <------------------ C (first write: copy materializes just above this)
        v7 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v8 = call consume_read_only(v7)
        ret u64 v8
    }

    fn consume_read_only(order: __ptr { u64, u64, u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64, u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
