// CORRECTNESS: a read via `cast_ptr` then GEP must rebuild the chain on `src`.
//
// Expected:
//   A = entry copy disappears,
//   B = copy materializes before the store,
//   C = read arm loads through a cast/GEP chain rooted at `w`.
script {
    entry fn main(flag: bool, w: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } copy

        entry(flag: bool, w: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, copy
        mem_copy_val v0, w // <------------------ A
        cbr flag, block_write(), block_read()

        block_write():
        v1 = get_local __ptr { u64, u64 }, copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B
        v5 = get_local __ptr { u64, u64 }, copy
        v6 = cast_ptr v5 to __ptr u8
        v7 = cast_ptr v6 to __ptr { u64, u64 }
        v8 = const u64 0
        v9 = get_elem_ptr v7, __ptr u64, v8
        v10 = load v9
        ret u64 v10

        block_read():
        v11 = get_local __ptr { u64, u64 }, copy
        v12 = cast_ptr v11 to __ptr u8
        v13 = cast_ptr v12 to __ptr { u64, u64 } // <------------------ C
        v14 = const u64 0
        v15 = get_elem_ptr v13, __ptr u64, v14
        v16 = load v15
        ret u64 v16
    }
}
