script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut u64 i
        local mut { u64, u64 } order_copy

        entry(mut n: u64, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        v5v1 = get_local __ptr u64, i
        v6v1 = const u64 0
        store v6v1 to v5v1
        br while()

        while():
        v9v1 = get_local __ptr u64, i
        v10v1 = load v9v1
        v11v1 = cmp lt v10v1 n
        cbr v11v1, while_body(), end_while()

        while_body():
        v13v1 = get_local __ptr u64, i
        v14v1 = load v13v1
        v15v1 = const u64 1
        v16v1 = add v14v1, v15v1
        store v16v1 to v13v1
        v18v1 = const u64 2
        v19v1 = mod v16v1, v18v1
        v20v1 = const u64 0
        v21v1 = cmp eq v19v1 v20v1
        cbr v21v1, do_continue(), do_write()

        do_continue():
        br while()

        do_write():
        v24v1 = get_local __ptr { u64, u64 }, order_copy
        v25v1 = const u64 1
        v26v1 = get_elem_ptr v24v1, __ptr u64, v25v1
        v27v1 = get_local __ptr u64, i
        v28v1 = load v27v1
        store v28v1 to v26v1
        br while()

        end_while():
        v31v1 = get_local __ptr { u64, u64 }, order_copy
        v32v1 = call consume_read_only(v31v1)
        ret u64 v32v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v35v1 = const u64 0
        v36v1 = get_elem_ptr order, __ptr u64, v35v1
        v37v1 = load v36v1
        ret u64 v37v1
    }
}
