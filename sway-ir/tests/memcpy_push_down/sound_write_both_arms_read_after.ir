// CORRECTNESS: both arms write (materialize independently), then a shared
// read after the join uses the private buffer. No pending edge into the join.
//
// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 1;
//     } else {
//         order_copy.prev = 2;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Expected:
//   A = entry copy disappears,
//   B/C = a copy materializes in each arm before its store,
//   D = join calls `consume_read_only` on `order_copy` (already private).
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_left(), block_right()

        block_left():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 1
        store v4 to v3 // <------------------ B
        br block_join()

        block_right():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = const u64 1
        v7 = get_elem_ptr v5, __ptr u64, v6
        v8 = const u64 2
        store v8 to v7 // <------------------ C
        br block_join()

        block_join(): // <------------------ D
        v9 = get_local __ptr { u64, u64 }, order_copy
        v10 = call consume_read_only(v9)
        ret u64 v10
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
