script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut u64 i
        local mut { u64, u64 } order_copy

        entry(mut n: u64, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        v5v1 = get_local __ptr u64, i
        v6v1 = const u64 0
        store v6v1 to v5v1
        br while()

        while():
        v9v1 = get_local __ptr u64, i
        v10v1 = load v9v1
        v11v1 = cmp lt v10v1 n
        cbr v11v1, while_body(), end_while()

        while_body():
        v13v1 = get_local __ptr { u64, u64 }, order_copy
        v14v1 = const u64 1
        v15v1 = get_elem_ptr v13v1, __ptr u64, v14v1
        v16v1 = get_local __ptr u64, i
        v17v1 = load v16v1
        store v17v1 to v15v1
        v19v1 = const u64 1
        v20v1 = add v17v1, v19v1
        store v20v1 to v16v1
        br while()

        end_while():
        v23v1 = get_local __ptr { u64, u64 }, order_copy
        v24v1 = call consume_read_only(v23v1)
        ret u64 v24v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v27v1 = const u64 0
        v28v1 = get_elem_ptr order, __ptr u64, v27v1
        v29v1 = load v28v1
        ret u64 v29v1
    }
}
