// ```sway
// script;
//
// struct Order {
//     a: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Order) -> u64 {
//     order.a
// }
//
// fn main(n: u64, order: Order) -> u64 {
//     let mut order_copy = order;
//     let mut i = 0;
//     while i < n {
//         i = i + 1;
//         if i % 2 == 0 {
//             continue;
//         }
//         order_copy.prev = i;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// `continue` skips the write on even iterations. The write still sits inside
// the loop body, so pending would cross a cycle — the pass must bail (must not
// sink the copy into the body where `continue` could re-execute it).
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` stays put (bail: pending would cross the loop).
script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut u64 i

        entry(n: u64, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        v1 = get_local __ptr u64, i
        v2 = const u64 0
        store v2 to v1
        br while()

        while():
        v3 = get_local __ptr u64, i
        v4 = load v3
        v5 = cmp lt v4 n
        cbr v5, while_body(), end_while()

        while_body():
        v6 = get_local __ptr u64, i
        v7 = load v6
        v8 = const u64 1
        v9 = add v7, v8
        store v9 to v6
        v10 = const u64 2
        v11 = mod v9, v10
        v12 = const u64 0
        v13 = cmp eq v11 v12
        cbr v13, do_continue(), do_write()

        do_continue():
        br while()

        do_write():
        v14 = get_local __ptr { u64, u64 }, order_copy
        v15 = const u64 1
        v16 = get_elem_ptr v14, __ptr u64, v15
        v17 = get_local __ptr u64, i
        v18 = load v17
        store v18 to v16 // Write skipped by `continue` on even i.
        br while()

        end_while():
        v19 = get_local __ptr { u64, u64 }, order_copy
        v20 = call consume_read_only(v19)
        ret u64 v20
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
