// V1 LIMIT: candidate copy itself lives inside a cycle.
//
// Why: mid-block `Pending` on a cycle block is invisible to the in/out cycle
// check alone, so v1 also rejects any candidate whose home block is cyclic.
//
// What a future version could do: allow *intra-iteration* sinking (copy once
// per iteration, only if that iteration writes), without carrying pending
// across the backedge.
//
// ```sway
// fn main(n: u64, order: Order) -> u64 {
//     let mut i = 0;
//     let mut acc = 0;
//     while i < n {
//         let mut order_copy = order;
//         order_copy.prev = i;
//         acc = consume_read_only(order_copy);
//         i = i + 1;
//     }
//     acc
// }
// ```
//
// Expected from memcpy-push-down (v1): opt does nothing —
//   A = the per-iteration `mem_copy_val` stays put.
script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut u64 i
        local mut u64 acc

        entry(n: u64, order: __ptr { u64, u64 }):
        v0 = get_local __ptr u64, i
        v1 = const u64 0
        store v1 to v0
        v2 = get_local __ptr u64, acc
        v3 = const u64 0
        store v3 to v2
        br while()

        while():
        v4 = get_local __ptr u64, i
        v5 = load v4
        v6 = cmp lt v5 n
        cbr v6, while_body(), end_while()

        while_body():
        v7 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v7, order // <------------------ A (must stay)
        v8 = get_local __ptr { u64, u64 }, order_copy
        v9 = const u64 1
        v10 = get_elem_ptr v8, __ptr u64, v9
        v11 = get_local __ptr u64, i
        v12 = load v11
        store v12 to v10
        v13 = get_local __ptr { u64, u64 }, order_copy
        v14 = call consume_read_only(v13)
        v15 = get_local __ptr u64, acc
        store v14 to v15
        v16 = const u64 1
        v17 = add v12, v16
        store v17 to v11
        br while()

        end_while():
        v18 = get_local __ptr u64, acc
        v19 = load v18
        ret u64 v19
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
