// OPT: nested live joins — prune a dominated pending_pred.
//
// What this tests
// ---------------
// Outer join has a critical edge from `block_a` (multi_succ_pending_pred).
// Inner join has its own pending_pred `block_fall_inner`, which `block_a`
// dominates. Materializing before `block_a`'s terminator already covers every
// path through `block_fall_inner`, so `must_materialize_before_exit` must keep
// only the undominated edge site (`block_a`). `O` must stay well-built (no
// comparable BeforeTerminators). With a cold side exit off entry, the copy
// sinks to `block_a` and cold stays copy-free.
//
// Terms: Glossary in `memcpy_push_down.rs`.
// Companion: `opt_nested_join_retain_over_dominated_pending_pred.ir` (no cold).
//
// ```sway
// fn main(go: bool, flag: bool, inner: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if !go { return 0; }
//     if flag {
//         if inner { order_copy.prev = 42; }
//         // else: empty fallthrough into inner_join
//     }
//     // else: critical block_a → outer_join
//     consume_read_only(order_copy)
// }
// ```
//
// CFG:
//
//               ┌─────────────────┐
//               │      entry      │
//               │ candidate; cbr  │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          ▼                           ▼
// ┌─────────────────┐         ┌─────────────────┐
// │     block_a     │         │   cold_exit     │
// │   (cbr flag)    │         │     ret 0       │
// └────────┬────────┘         └─────────────────┘
//          │
//    ┌─────┴──────────────────┐
//    ▼                        │  flag == false
// ┌────────────┐              │  block_a → outer_join
// │  block_mid │              │
// │ (cbr inner)│              │
// └─────┬──────┘              │
//       │                     │
//  ┌────┴─────┐               │
//  ▼          ▼               │
// write    fall_inner         │
// store    (inner pending_pred│
//  │        of inner_join)    │
//  └────┬─────┘               │
//       ▼                     │
//  inner_join                 │
//       │                     │
//       └──────────┬──────────┘
//                  ▼
//            outer_join
//            consume(copy)
//
// Expected:
//   A = entry copy disappears,
//   B = one copy at block_a before the flag cbr,
//   C = cold_exit has no copy,
//   D = fall_inner has no copy (dominated pending_pred pruned).
script {
    entry fn main(go: bool, flag: bool, inner: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(go: bool, flag: bool, inner: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr go, block_a(), block_cold_exit()

        block_a(): // <------------------ B
        cbr flag, block_mid(), block_outer_join()

        block_mid():
        cbr inner, block_write(), block_fall_inner()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br block_inner_join()

        block_fall_inner(): // <------------------ D
        br block_inner_join()

        block_inner_join():
        br block_outer_join()

        block_outer_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6

        block_cold_exit(): // <------------------ C
        v7 = const u64 0
        ret u64 v7
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
