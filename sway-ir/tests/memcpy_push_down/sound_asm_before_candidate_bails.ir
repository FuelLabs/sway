// SOUNDNESS: `asm` MayWrite on `dst` before the candidate — bail.
//
// Expected: the rebinding `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        v1 = asm(r1: v0) -> u64 r1 {
            movi r1 i1
        }
        v2 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v2, order // <------------------ must stay
        cbr flag, block_write(), block_fallthrough()

        block_write():
        v3 = get_local __ptr { u64, u64 }, order_copy
        v4 = const u64 1
        v5 = get_elem_ptr v3, __ptr u64, v4
        v6 = const u64 42
        store v6 to v5
        br block_join()

        block_fallthrough():
        br block_join()

        block_join():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_read_only(v7)
        ret u64 v8
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
