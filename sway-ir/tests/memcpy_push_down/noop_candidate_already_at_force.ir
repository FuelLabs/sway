// BEHAVIOR: candidate already sits immediately before its only force site
// (`MayWrite` call) with no delegated reads — profitability declines the
// rewrite (`keep_candidate` alone is not profitable).
//
// Expected: `mem_copy_val` stays put (Modified: false).
script {
    entry fn main(order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // already at force
        v1 = call poke_mut(v0)
        v2 = get_local __ptr { u64, u64 }, order_copy
        v3 = call consume_read_only(v2)
        ret u64 v3
    }

    fn poke_mut(order: __ptr { u64, u64 }) -> () {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = const u64 1
        store v2 to v1
        v3 = const unit ()
        ret () v3
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
