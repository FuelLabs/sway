// Side exit off entry, and under the hot arm a *nested* if/no-else join.
// Global ncd fails; the hot arm's subset coalesces to `hot` (not sunk into
// both inner arms).
//
// ```sway
// fn main(hot: bool, inner: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if hot {
//         if inner { order_copy.prev = 42; }
//         consume_read_only(order_copy)
//     } else {
//         0
//     }
// }
// ```
//
// Expected:
//   A = entry copy disappears,
//   B = one copy at `hot` before the inner cbr,
//   C = `cold_exit` has no copy,
//   no copies in `inner_write` / `inner_fallthrough`.
script {
    entry fn main(hot: bool, inner: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(hot: bool, inner: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr hot, block_hot(), block_cold_exit()

        block_hot(): // <------------------ B
        cbr inner, inner_write(), inner_fallthrough()

        inner_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br inner_join()

        inner_fallthrough():
        br inner_join()

        inner_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6

        block_cold_exit(): // <------------------ C
        v7 = const u64 0
        ret u64 v7
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
