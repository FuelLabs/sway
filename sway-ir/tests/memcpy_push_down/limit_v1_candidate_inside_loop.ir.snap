script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut u64 acc
        local mut u64 i
        local mut { u64, u64 } order_copy

        entry(mut n: u64, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr u64, i
        v4v1 = const u64 0
        store v4v1 to v3v1
        v6v1 = get_local __ptr u64, acc
        v7v1 = const u64 0
        store v7v1 to v6v1
        br while()

        while():
        v10v1 = get_local __ptr u64, i
        v11v1 = load v10v1
        v12v1 = cmp lt v11v1 n
        cbr v12v1, while_body(), end_while()

        while_body():
        v14v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v14v1, order
        v16v1 = get_local __ptr { u64, u64 }, order_copy
        v17v1 = const u64 1
        v18v1 = get_elem_ptr v16v1, __ptr u64, v17v1
        v19v1 = get_local __ptr u64, i
        v20v1 = load v19v1
        store v20v1 to v18v1
        v22v1 = get_local __ptr { u64, u64 }, order_copy
        v23v1 = call consume_read_only(v22v1)
        v24v1 = get_local __ptr u64, acc
        store v23v1 to v24v1
        v26v1 = const u64 1
        v27v1 = add v20v1, v26v1
        store v27v1 to v19v1
        br while()

        end_while():
        v30v1 = get_local __ptr u64, acc
        v31v1 = load v30v1
        ret u64 v31v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v34v1 = const u64 0
        v35v1 = get_elem_ptr order, __ptr u64, v34v1
        v36v1 = load v35v1
        ret u64 v36v1
    }
}
