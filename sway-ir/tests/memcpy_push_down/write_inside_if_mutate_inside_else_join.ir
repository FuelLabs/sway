// Corresponding Sway (this hand-written IR mirrors its lowering):
//
// ```sway
// script;
//
// struct Order {
//     a: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_mutating(ref mut order: Order) -> u64 {
//     order.prev = order.a;
//     order.a
// }
//
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//         consume_mutating(order_copy)
//     } else {
//         consume_mutating(order_copy)
//     }
// }
// ```
//
// Same shape as `write_inside_if_read_inside_else_join`, but the callee writes
// through its argument (`ref mut` in Sway). A mutating callee must be viewed
// as a write: it can never receive the source buffer, only the private copy.
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` disappears,
//   B = a copy materializes in `block_write`, just before the store,
//   C = a copy ALSO materializes in `block_read`, just before the call
//       (no delegation: `consume_mutating` may write),
//   D = nothing is copied at the (dead) join.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_write(), block_read()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B (first write: copy materializes just above this)
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_mutating(v5) // Mutating call on the private buffer.
        br block_join(v6)

        block_read():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_mutating(v7) // <------------------ C
        br block_join(v8)

        block_join(v9: u64): // <------------------ D
        ret u64 v9
    }

    fn consume_mutating(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        v3 = const u64 1
        v4 = get_elem_ptr order, __ptr u64, v3
        store v2 to v4 // Writes through the argument: the parameter is mutable.
        ret u64 v2
    }
}
