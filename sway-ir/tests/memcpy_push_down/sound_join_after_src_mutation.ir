// SOUNDNESS (classic hole): one path mutates `src` (forcing materialization),
// the other stays pending; they join and then read `dst`. The pending edge
// into the join MUST materialize — otherwise the shared read would be
// delegated to `src` and observe the mutation from the other path.
//
// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order.a = 99;
//     }
//     consume_read_only(order_copy) // must see the *original* order on both paths
// }
// ```
//
// Expected (fall-through edge already split):
//   A = entry copy disappears,
//   B = a copy materializes in `block_mutate_src` before the store to `order`,
//   C = a copy materializes on the fall-through edge into the join,
//   D = join calls `consume_read_only` on `order_copy` (never on `order`).
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_mutate_src(), block_fallthrough()

        block_mutate_src():
        v1 = const u64 0
        v2 = get_elem_ptr order, __ptr u64, v1
        v3 = const u64 99
        store v3 to v2 // <------------------ B
        br block_join()

        block_fallthrough(): // <------------------ C
        br block_join()

        block_join(): // <------------------ D
        v4 = get_local __ptr { u64, u64 }, order_copy
        v5 = call consume_read_only(v4)
        ret u64 v5
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
