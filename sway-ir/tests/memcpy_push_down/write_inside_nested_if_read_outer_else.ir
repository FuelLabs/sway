// Corresponding Sway (this hand-written IR mirrors its lowering; the inner
// fall-through edge is already split — v1 does not itself split critical
// edges):
//
// ```sway
// script;
//
// struct Order {
//     a: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Order) -> u64 {
//     order.a
// }
//
// fn main(outer: bool, inner: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if outer {
//         if inner {
//             order_copy.prev = 42;
//         }
//         consume_read_only(order_copy)
//     } else {
//         consume_read_only(order_copy)
//     }
// }
// ```
//
// Nested `if`: write only in the inner-then arm; shared read after the
// inner join; outer-else only reads.
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` disappears,
//   B = a copy materializes in `inner_write`, just before the store,
//   C = a copy materializes on the inner fall-through edge,
//   D = `outer_else` calls `consume_read_only` on the source argument.
script {
    entry fn main(outer: bool, inner: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(outer: bool, inner: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr outer, outer_then(), outer_else()

        outer_then():
        cbr inner, inner_write(), inner_fallthrough()

        inner_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B
        br inner_join()

        inner_fallthrough(): // <------------------ C
        br inner_join()

        inner_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        br block_join(v6)

        outer_else():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_read_only(v7) // <------------------ D
        br block_join(v8)

        block_join(v9: u64):
        ret u64 v9
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
