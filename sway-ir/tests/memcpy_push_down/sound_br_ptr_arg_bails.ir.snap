script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(mut flag: bool, order: __ptr { u64, u64 }):
        v6v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v6v1, order
        v8v1 = get_local __ptr { u64, u64 }, order_copy
        cbr flag, block_write(v8v1), block_read(v8v1)

        block_write(v3v1: __ptr { u64, u64 }):
        v10v1 = const u64 1
        v11v1 = get_elem_ptr v3v1, __ptr u64, v10v1
        v12v1 = const u64 42
        store v12v1 to v11v1
        v14v1 = call consume_read_only(v3v1)
        br block_join(v14v1)

        block_read(v4v1: __ptr { u64, u64 }):
        v16v1 = call consume_read_only(v4v1)
        br block_join(v16v1)

        block_join(v5v1: u64):
        ret u64 v5v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v20v1 = const u64 0
        v21v1 = get_elem_ptr order, __ptr u64, v20v1
        v22v1 = load v21v1
        ret u64 v22v1
    }
}
