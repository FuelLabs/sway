// LIMIT: no loop-preheader materialization.
//
// Why: a writable loop entered while pending would need the copy placed on
// the loop-entry edge (once per entry), not inside the body. The pass refuses
// any pending state on a cycle instead.
//
// ```sway
// fn main(n: u64, order: Order) -> u64 {
//     let mut order_copy = order;
//     let mut i = 0;
//     while i < n {
//         order_copy.prev = i;
//         i = i + 1;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Expected from memcpy-push-down: opt does nothing —
//   A = the entry `mem_copy_val` stays put.
script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut u64 i

        entry(n: u64, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A (must stay)
        v1 = get_local __ptr u64, i
        v2 = const u64 0
        store v2 to v1
        br while()

        while():
        v3 = get_local __ptr u64, i
        v4 = load v3
        v5 = cmp lt v4 n
        cbr v5, while_body(), end_while()

        while_body():
        v6 = get_local __ptr { u64, u64 }, order_copy
        v7 = const u64 1
        v8 = get_elem_ptr v6, __ptr u64, v7
        v9 = get_local __ptr u64, i
        v10 = load v9
        store v10 to v8
        v11 = const u64 1
        v12 = add v10, v11
        store v12 to v9
        br while()

        end_while():
        v13 = get_local __ptr { u64, u64 }, order_copy
        v14 = call consume_read_only(v13)
        ret u64 v14
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
