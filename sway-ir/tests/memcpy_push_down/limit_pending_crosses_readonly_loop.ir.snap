script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut u64 acc
        local mut u64 i
        local mut { u64, u64 } order_copy

        entry(mut n: u64, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        v5v1 = get_local __ptr u64, i
        v6v1 = const u64 0
        store v6v1 to v5v1
        v8v1 = get_local __ptr u64, acc
        v9v1 = const u64 0
        store v9v1 to v8v1
        br while()

        while():
        v12v1 = get_local __ptr u64, i
        v13v1 = load v12v1
        v14v1 = cmp lt v13v1 n
        cbr v14v1, while_body(), end_while()

        while_body():
        v16v1 = get_local __ptr { u64, u64 }, order_copy
        v17v1 = call consume_read_only(v16v1)
        v18v1 = get_local __ptr u64, acc
        store v17v1 to v18v1
        v20v1 = get_local __ptr u64, i
        v21v1 = load v20v1
        v22v1 = const u64 1
        v23v1 = add v21v1, v22v1
        store v23v1 to v20v1
        br while()

        end_while():
        v26v1 = get_local __ptr u64, acc
        v27v1 = load v26v1
        ret u64 v27v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v30v1 = const u64 0
        v31v1 = get_elem_ptr order, __ptr u64, v30v1
        v32v1 = load v31v1
        ret u64 v32v1
    }
}
