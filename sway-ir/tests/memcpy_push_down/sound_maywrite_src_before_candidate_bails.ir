// SOUNDNESS: MayWrite on *src* before the candidate copy — bail (alias window).
//
// Expected: the rebinding `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = call poke_mut(order) // MayWrite on src before candidate
        v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v1, order // <------------------ must stay
        cbr flag, block_write(), block_fallthrough()

        block_write():
        v2 = get_local __ptr { u64, u64 }, order_copy
        v3 = const u64 1
        v4 = get_elem_ptr v2, __ptr u64, v3
        v5 = const u64 42
        store v5 to v4
        br block_join()

        block_fallthrough():
        br block_join()

        block_join():
        v6 = get_local __ptr { u64, u64 }, order_copy
        v7 = call consume_read_only(v6)
        ret u64 v7
    }

    fn poke_mut(order: __ptr { u64, u64 }) -> () {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = const u64 1
        store v2 to v1
        v3 = const unit ()
        ret () v3
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
