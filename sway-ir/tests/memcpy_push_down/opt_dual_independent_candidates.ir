// CORRECTNESS: two independent copies are both push-downed across restarts.
//
// Expected: both entry copies disappear; each write arm materializes its own
// copy; each read arm delegates to its source.
script {
    entry fn main(flag: bool, a: __ptr { u64, u64 }, b: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } a_copy
        local mut { u64, u64 } b_copy

        entry(flag: bool, a: __ptr { u64, u64 }, b: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, a_copy
        mem_copy_val v0, a // <------------------ A1
        v1 = get_local __ptr { u64, u64 }, b_copy
        mem_copy_val v1, b // <------------------ A2
        cbr flag, block_write(), block_read()

        block_write():
        v2 = get_local __ptr { u64, u64 }, a_copy
        v3 = const u64 1
        v4 = get_elem_ptr v2, __ptr u64, v3
        v5 = const u64 1
        store v5 to v4 // <------------------ B1
        v6 = get_local __ptr { u64, u64 }, b_copy
        v7 = const u64 1
        v8 = get_elem_ptr v6, __ptr u64, v7
        v9 = const u64 2
        store v9 to v8 // <------------------ B2
        v10 = get_local __ptr { u64, u64 }, a_copy
        v11 = call consume_read_only(v10)
        v12 = get_local __ptr { u64, u64 }, b_copy
        v13 = call consume_read_only(v12)
        v14 = add v11, v13
        br block_join(v14)

        block_read():
        v15 = get_local __ptr { u64, u64 }, a_copy
        v16 = call consume_read_only(v15) // <------------------ C1
        v17 = get_local __ptr { u64, u64 }, b_copy
        v18 = call consume_read_only(v17) // <------------------ C2
        v19 = add v16, v18
        br block_join(v19)

        block_join(v20: u64):
        ret u64 v20
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
