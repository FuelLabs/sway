// ```sway
// script;
//
// struct Order {
//     a: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Order) -> u64 {
//     order.a
// }
//
// fn main(n: u64, order: Order) -> u64 {
//     let mut order_copy = order;
//     let mut i = 0;
//     while i < n {
//         let mut j = 0;
//         while j < n {
//             if j == 0 {
//                 order_copy.prev = 42;
//                 // break the *outer* loop
//                 i = n;
//                 break;
//             }
//             j = j + 1;
//         }
//         i = i + 1;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Nested loops: write in the inner body, then break out of the inner loop
// after forcing the outer to exit. Pending still touches a cycle → the pass bails.
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` stays put (bail: pending would cross a loop).
script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut u64 i
        local mut u64 j

        entry(n: u64, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        v1 = get_local __ptr u64, i
        v2 = const u64 0
        store v2 to v1
        br outer()

        outer():
        v3 = get_local __ptr u64, i
        v4 = load v3
        v5 = cmp lt v4 n
        cbr v5, outer_body(), end_outer()

        outer_body():
        v6 = get_local __ptr u64, j
        v7 = const u64 0
        store v7 to v6
        br inner()

        inner():
        v8 = get_local __ptr u64, j
        v9 = load v8
        v10 = cmp lt v9 n
        cbr v10, inner_body(), outer_inc()

        inner_body():
        v11 = get_local __ptr u64, j
        v12 = load v11
        v13 = const u64 0
        v14 = cmp eq v12 v13
        cbr v14, do_write_break(), inner_inc()

        do_write_break():
        v15 = get_local __ptr { u64, u64 }, order_copy
        v16 = const u64 1
        v17 = get_elem_ptr v15, __ptr u64, v16
        v18 = const u64 42
        store v18 to v17 // Write, then break inner and force outer exit.
        v19 = get_local __ptr u64, i
        store n to v19
        br outer_inc()

        inner_inc():
        v20 = get_local __ptr u64, j
        v21 = load v20
        v22 = const u64 1
        v23 = add v21, v22
        store v23 to v20
        br inner()

        outer_inc():
        v24 = get_local __ptr u64, i
        v25 = load v24
        v26 = const u64 1
        v27 = add v25, v26
        store v27 to v24
        br outer()

        end_outer():
        v28 = get_local __ptr { u64, u64 }, order_copy
        v29 = call consume_read_only(v28)
        ret u64 v29
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
