// Corresponding Sway (this hand-written IR mirrors its lowering):
//
// ```sway
// script;
//
// struct Order {
//     a: u64,
//     prev: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Order) -> u64 {
//     order.a
// }
//
// fn main(c1: bool, c2: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if c1 {
//         order_copy.prev = 42;
//         consume_read_only(order_copy)
//     } else if c2 {
//         consume_read_only(order_copy)
//     } else {
//         consume_read_only(order_copy)
//     }
// }
// ```
//
// An `else if` chain: write only in the first arm, read in the other two,
// all three joining afterwards.
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` disappears,
//   B = a copy materializes in `block_write`, just before the store,
//   C = both read arms call `consume_read_only` on the source argument,
//   D = nothing is copied at the (dead) join.
script {
    entry fn main(c1: bool, c2: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(c1: bool, c2: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr c1, block_write(), block_elseif()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        br block_join(v6)

        block_elseif():
        cbr c2, block_read_mid(), block_read_else()

        block_read_mid():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_read_only(v7) // <------------------ C
        br block_join(v8)

        block_read_else():
        v9 = get_local __ptr { u64, u64 }, order_copy
        v10 = call consume_read_only(v9) // <------------------ C
        br block_join(v10)

        block_join(v11: u64): // <------------------ D
        ret u64 v11
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
