// SOUNDNESS: using `dst` as an `init_aggr` initializer captures the pointer.
//
// Expected: entry `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut { __ptr { u64, u64 } } holder

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ must stay
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = get_local __ptr { __ptr { u64, u64 } }, holder
        v3 = init_aggr v2 [v1]
        cbr flag, block_write(), block_read()

        block_write():
        v4 = get_local __ptr { u64, u64 }, order_copy
        v5 = const u64 1
        v6 = get_elem_ptr v4, __ptr u64, v5
        v7 = const u64 42
        store v7 to v6
        v8 = get_local __ptr { u64, u64 }, order_copy
        v9 = call consume_read_only(v8)
        br block_join(v9)

        block_read():
        v10 = get_local __ptr { u64, u64 }, order_copy
        v11 = call consume_read_only(v10)
        br block_join(v11)

        block_join(v12: u64):
        ret u64 v12
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
