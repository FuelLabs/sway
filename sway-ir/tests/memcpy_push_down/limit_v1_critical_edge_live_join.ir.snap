script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(mut flag: bool, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        cbr flag, block_write(), block_join()

        block_write():
        v6v1 = get_local __ptr { u64, u64 }, order_copy
        v7v1 = const u64 1
        v8v1 = get_elem_ptr v6v1, __ptr u64, v7v1
        v9v1 = const u64 42
        store v9v1 to v8v1
        br block_join()

        block_join():
        v12v1 = get_local __ptr { u64, u64 }, order_copy
        v13v1 = call consume_read_only(v12v1)
        ret u64 v13v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v16v1 = const u64 0
        v17v1 = get_elem_ptr order, __ptr u64, v16v1
        v18v1 = load v17v1
        ret u64 v18v1
    }
