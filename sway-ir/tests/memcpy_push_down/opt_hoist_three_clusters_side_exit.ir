// Three independent write/fallthrough regions + a side exit. Global ncd fails
// anticipation; each region coalesces to one copy.
//
// Expected:
//   A = entry copy disappears,
//   B/C/D = one copy at the head of each region (`reg0` / `reg1` / `reg2`),
//   E = `early_exit` has no copy.
script {
    entry fn main(sel0: bool, sel1: bool, go: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(sel0: bool, sel1: bool, go: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr sel0, reg0(), rest0()

        rest0():
        cbr sel1, reg1(), rest1()

        rest1():
        cbr go, reg2(), early_exit()

        reg0(): // <------------------ B
        cbr go, r0_write(), r0_fallthrough()

        r0_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 10
        store v4 to v3
        br r0_join()

        r0_fallthrough():
        br r0_join()

        r0_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6

        reg1(): // <------------------ C
        cbr go, r1_write(), r1_fallthrough()

        r1_write():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = const u64 1
        v9 = get_elem_ptr v7, __ptr u64, v8
        v10 = const u64 20
        store v10 to v9
        br r1_join()

        r1_fallthrough():
        br r1_join()

        r1_join():
        v11 = get_local __ptr { u64, u64 }, order_copy
        v12 = call consume_read_only(v11)
        ret u64 v12

        reg2(): // <------------------ D
        cbr go, r2_write(), r2_fallthrough()

        r2_write():
        v13 = get_local __ptr { u64, u64 }, order_copy
        v14 = const u64 1
        v15 = get_elem_ptr v13, __ptr u64, v14
        v16 = const u64 30
        store v16 to v15
        br r2_join()

        r2_fallthrough():
        br r2_join()

        r2_join():
        v17 = get_local __ptr { u64, u64 }, order_copy
        v18 = call consume_read_only(v17)
        ret u64 v18

        early_exit(): // <------------------ E
        v19 = const u64 0
        ret u64 v19
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
