// FILTER: source must be a local or *entry* block argument, not a mid-CFG arg.
//
//
// ```sway
// script;
//
// struct Pair {
//     a: u64,
//     b: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Pair) -> u64 {
//     order.a
// }
//
// fn main(flag: bool, order: Pair) -> u64 {
//     // IR: both cbr arms pass `order` into a join block arg `src`, then
//     // `mem_copy_val` uses that mid-CFG arg (not an entry arg / local).
//     let src = if flag { order } else { order };
//     let mut order_copy = src;
//     order_copy.b = 42;
//     consume_read_only(order_copy)
// }
// ```
//
// Expected: Modified: false.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        cbr flag, with_arg(order), with_arg(order)

        with_arg(src: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, src // src is non-entry block arg
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
