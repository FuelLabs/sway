script {
    entry fn main(n: u64, order: __ptr { u64, u64 }) -> u64 {
        local mut u64 i
        local mut u64 j
        local mut { u64, u64 } order_copy

        entry(mut n: u64, order: __ptr { u64, u64 }):
        v3v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v3v1, order
        v5v1 = get_local __ptr u64, i
        v6v1 = const u64 0
        store v6v1 to v5v1
        br outer()

        outer():
        v9v1 = get_local __ptr u64, i
        v10v1 = load v9v1
        v11v1 = cmp lt v10v1 n
        cbr v11v1, outer_body(), end_outer()

        outer_body():
        v13v1 = get_local __ptr u64, j
        v14v1 = const u64 0
        store v14v1 to v13v1
        br inner()

        inner():
        v17v1 = get_local __ptr u64, j
        v18v1 = load v17v1
        v19v1 = cmp lt v18v1 n
        cbr v19v1, inner_body(), outer_inc()

        inner_body():
        v21v1 = get_local __ptr u64, j
        v22v1 = load v21v1
        v23v1 = const u64 0
        v24v1 = cmp eq v22v1 v23v1
        cbr v24v1, do_write_break(), inner_inc()

        do_write_break():
        v26v1 = get_local __ptr { u64, u64 }, order_copy
        v27v1 = const u64 1
        v28v1 = get_elem_ptr v26v1, __ptr u64, v27v1
        v29v1 = const u64 42
        store v29v1 to v28v1
        v31v1 = get_local __ptr u64, i
        store n to v31v1
        br outer_inc()

        inner_inc():
        v34v1 = get_local __ptr u64, j
        v35v1 = load v34v1
        v36v1 = const u64 1
        v37v1 = add v35v1, v36v1
        store v37v1 to v34v1
        br inner()

        outer_inc():
        v40v1 = get_local __ptr u64, i
        v41v1 = load v40v1
        v42v1 = const u64 1
        v43v1 = add v41v1, v42v1
        store v43v1 to v40v1
        br outer()

        end_outer():
        v46v1 = get_local __ptr { u64, u64 }, order_copy
        v47v1 = call consume_read_only(v46v1)
        ret u64 v47v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
