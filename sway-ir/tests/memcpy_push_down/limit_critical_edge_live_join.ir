// LIMIT: no critical-edge splitting.
//
// Why: a live join of `Pending` and `Materialized` wants a copy only on the
// pending incoming edge. If that edge's predecessor has another successor,
// inserting at the pred terminator would also run on the non-pending edge.
// This pass does not split critical edges, so it bails.
//
// Contrast: `write_inside_if_no_else_read_after` is the same Sway with the
// fall-through edge already split — there the pass *does* optimize.
//
// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Expected from memcpy-push-down: opt does nothing —
//   A = the entry `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A (must stay)
        cbr flag, block_write(), block_join()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br block_join()

        block_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
