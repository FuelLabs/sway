// LIMIT: `multi_succ_pending_pred` — no critical-edge splitting yet.
//
// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Contrast: `write_inside_if_no_else_read_after` is the same Sway with the
// fall-through edge already split — there the pass *does* optimize.
//
// Terms: see Glossary in `sway-ir/src/optimize/memcpy_push_down.rs`.
//
// CFG (empty false branch — no fallthrough block):
//
//               ┌─────────────────┐
//               │      entry      │
//               │    (cbr flag)   │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          │                           │
//          │ flag == true              │ flag == false
//          │ entry → block_write       │ entry → block_join
//          ▼                           │
// ┌─────────────────┐                  │
// │   block_write   │                  │
// │ store to copy   │                  │
// └────────┬────────┘                  │
//          │                           │
//          │ block_write → block_join  │
//          │                           │
//          ▼                           ▼
//               ┌─────────────────┐
//               │    block_join   │
//               │ consume(copy)   │
//               └─────────────────┘
//
// Steps that mark `entry` with must_materialize_before_exit:
//
// 1. Pending after the candidate
//    In `entry`, after the logical copy: state = Pending.
//    Out-state(entry) = Pending on both outgoing edges.
//
// 2. block_write
//    In-state Pending → partial write → materialize on that path.
//    Out-state(block_write) = Materialized.
//    Edge block_write → block_join arrives Materialized.
//
// 3. Empty false edge
//    entry → block_join carries Pending straight into the join (no intermediate
//    block).
//
// 4. Meet at block_join → in_states_disagree
//    Pred out-states: Materialized vs Pending → join in-state Materialized,
//    in_states_disagree = true.
//
// 5. uses_dst
//    consume(order_copy) → block_join ∈ uses_dst. The disagreement matters.
//
// 6. must_materialize_before_exit on the pending pred
//    Pending predecessor of the join = entry.
//    Mark must_materialize_before_exit(entry).
//    So entry is a pending_pred.
//
// 7. multi_succ_pending_pred + keep_candidate
//    entry has two successors (block_write, block_join) → it is a
//    multi_succ_pending_pred. Forcing entry materializes its out-state, so
//    the write arm does not add a separate BeforeInst(store). The candidate
//    already sits immediately before entry's terminator → keep_candidate,
//    empty edge_inserts. One copy at entry is optimal; no rewrite.
//
// Expected from memcpy-push-down: opt does nothing —
//   A = the entry `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A (must stay)
        cbr flag, block_write(), block_join()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br block_join()

        block_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
