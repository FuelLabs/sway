// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//     }
//     consume_read_only(order_copy)
// }
// ```
//
// Split-edge twin of `limit_critical_edge_live_join`: same Sway, but the
// false edge is an empty `block_fallthrough` so there is no
// `multi_succ_pending_pred`. Terms: Glossary in `memcpy_push_down.rs`.
//
// CFG:
//
//               ┌─────────────────┐
//               │      entry      │
//               │ candidate; cbr  │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          │                           │
//          ▼                           ▼
// ┌─────────────────┐         ┌─────────────────┐
// │   block_write   │         │block_fallthrough│
// │ PartialWrite    │         │ (empty)         │
// └────────┬────────┘         └────────┬────────┘
//          │                           │
//          └─────────────┬─────────────┘
//                        ▼
//               ┌─────────────────┐
//               │    block_join   │
//               │ consume(copy)   │
//               └─────────────────┘
//
// Steps:
//
// 1. After the candidate in `entry`: Pending on both edges.
// 2. `block_write`: PartialWrite while Pending → CandidateSite::BeforeInst(store);
//    out-state Materialized.
// 3. `block_fallthrough`: still Pending; single successor →
//    must_materialize_before_exit → CandidateSite::BeforeTerminator(fallthrough).
// 4. `block_join`: in_states_disagree (Materialized vs Pending) and uses_dst;
//    fallthrough is the pending_pred (already marked). Not multi_succ.
// 5. O = { BeforeInst(store), BeforeTerminator(fallthrough) }.
//    D = ncd(O) = entry. every_path_needs_copy(entry): yes (both paths hit O).
// 6. Coalesce → RetainCandidate: leave the entry mem_copy; no per-arm copies.
//
// Expected:
//   A = entry mem_copy stays (Modified: false),
//   B/C = no per-arm copies.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_write(), block_fallthrough()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B
        br block_join()

        block_fallthrough(): // <------------------ C
        br block_join()

        block_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
