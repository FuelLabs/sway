// Two independent diamonds + a side exit. Full ncd(O) is entry and is not
// anticipated (early exit never hits O). Cluster coalesce still merges each
// diamond on its own.
//
// ```sway
// fn main(left: bool, right: bool, go: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if left {
//         if go { order_copy.prev = 1; }
//         return consume_read_only(order_copy);
//     } else if right {
//         if go { order_copy.prev = 2; }
//         return consume_read_only(order_copy);
//     } else {
//         return 0;
//     }
// }
// ```
//
// Expected from memcpy-push-down:
//   A = entry copy disappears,
//   B = one copy at the start of `block_left` (before the inner cbr),
//   C = one copy at the start of `block_right` (before the inner cbr),
//   D = `early_exit` has no copy,
//   no per-arm copies inside either diamond.
script {
    entry fn main(left: bool, right: bool, go: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(left: bool, right: bool, go: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr left, block_left(), block_not_left()

        block_not_left():
        cbr right, block_right(), block_early_exit()

        block_left(): // <------------------ B
        cbr go, left_write(), left_fallthrough()

        left_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 1
        store v4 to v3
        br left_join()

        left_fallthrough():
        br left_join()

        left_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6

        block_right(): // <------------------ C
        cbr go, right_write(), right_fallthrough()

        right_write():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = const u64 1
        v9 = get_elem_ptr v7, __ptr u64, v8
        v10 = const u64 2
        store v10 to v9
        br right_join()

        right_fallthrough():
        br right_join()

        right_join():
        v11 = get_local __ptr { u64, u64 }, order_copy
        v12 = call consume_read_only(v11)
        ret u64 v12

        block_early_exit(): // <------------------ D
        v13 = const u64 0
        ret u64 v13
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
