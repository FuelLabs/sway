// SOUNDNESS: in one block, a read of `dst` while pending must be delegated,
// and a later write must materialize just before the store — never the reverse
// order (which would make the read see an uninit/wrong buffer).
//
// ```sway
// fn main(order: Order) -> u64 {
//     let mut order_copy = order;
//     let x = order_copy.a;      // read first
//     order_copy.prev = 42;     // write second
//     x + order_copy.prev
// }
// ```
//
// Expected:
//   A = entry copy disappears,
//   B = the load of field 0 is rewritten to load from `order`,
//   C = a copy materializes just before the store to field 1.
script {
    entry fn main(order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 0
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = load v3 // <------------------ B (must load from `order`)
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = const u64 1
        v7 = get_elem_ptr v5, __ptr u64, v6
        v8 = const u64 42
        store v8 to v7 // <------------------ C
        v9 = get_local __ptr { u64, u64 }, order_copy
        v10 = const u64 1
        v11 = get_elem_ptr v9, __ptr u64, v10
        v12 = load v11
        v13 = add v4, v12
        ret u64 v13
    }
}
