// OPT: nested live joins — retain the candidate over a dominated pending_pred.
//
// What this tests
// ---------------
// Same nesting as `opt_nested_join_prune_dominated_pending_pred.ir`, but the
// candidate already sits on the outer `multi_succ_pending_pred` (entry), and
// there is no cold side exit. Inner join still marks `block_fall_inner` in
// `must_materialize_before_exit`. That site is dominated by entry: pruning it
// leaves only `keep_candidate`. The entry copy stays; no second copy on
// `block_fall_inner` (that would make the fallthrough path pay twice).
//
// Terms: Glossary in `memcpy_push_down.rs`.
//
// ```sway
// fn main(flag: bool, inner: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         if inner { order_copy.prev = 42; }
//         // else: empty fallthrough into inner_join
//     }
//     // else: critical entry → outer_join
//     consume_read_only(order_copy)
// }
// ```
//
// CFG:
//
//               ┌─────────────────┐
//               │      entry      │
//               │ candidate; cbr  │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          ▼                           │  flag == false
// ┌─────────────────┐                  │  entry → outer_join
// │    block_mid    │                  │
// │   (cbr inner)   │                  │
// └────────┬────────┘                  │
//          │                           │
//     ┌────┴─────┐                     │
//     ▼          ▼                     │
//   write    fall_inner                │
//   store    (inner pending_pred)      │
//     │          │                     │
//     └────┬─────┘                     │
//          ▼                           │
//     inner_join                       │
//          │                           │
//          └─────────────┬─────────────┘
//                        ▼
//                  outer_join
//                  consume(copy)
//
// Expected:
//   A = entry mem_copy stays (Modified: false),
//   B = fall_inner has no copy (dominated pending_pred pruned).
script {
    entry fn main(flag: bool, inner: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, inner: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_mid(), block_outer_join()

        block_mid():
        cbr inner, block_write(), block_fall_inner()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3
        br block_inner_join()

        block_fall_inner(): // <------------------ B
        br block_inner_join()

        block_inner_join():
        br block_outer_join()

        block_outer_join():
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5)
        ret u64 v6
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
