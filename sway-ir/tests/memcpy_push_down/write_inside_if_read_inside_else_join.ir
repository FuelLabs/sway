// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//         consume_read_only(order_copy)
//     } else {
//         consume_read_only(order_copy)
//     }
// }
// ```
//
// Write on one arm, read-only on the other; join only merges u64 results —
// not uses_dst for order_copy. Terms: Glossary in `memcpy_push_down.rs`.
//
// Canonical sink+delegate diamond. Same pass decision covers Sway surfaces
// that lower to this family (if-let / else-if / match / && / || / call-only
// fallthrough). Direct field-load twin: `write_inside_if_read_inside_else`.
//
// CFG:
//
//               ┌─────────────────┐
//               │      entry      │
//               │ candidate; cbr  │
//               └────────┬────────┘
//                        │
//          ┌─────────────┴─────────────┐
//          ▼                           ▼
// ┌─────────────────┐         ┌─────────────────┐
// │   block_write   │         │   block_read    │
// │ store; consume  │         │ consume (Pending│
// │ (Materialized)  │         │  → delegate src)│
// └────────┬────────┘         └────────┬────────┘
//          │  br join(v)               │  br join(v)
//          └─────────────┬─────────────┘
//                        ▼
//               ┌─────────────────┐
//               │    block_join   │
//               │ ret phi (u64)   │  ← not uses_dst for order_copy
//               └─────────────────┘
//
// Steps:
//
// 1. After candidate: Pending on both edges.
// 2. block_write: PartialWrite → CandidateSite::BeforeInst(store); Materialized;
//    then consume on the private buffer.
// 3. block_read: still Pending; Read/call → delegate to `order` (rewrite),
//    no materialize.
// 4. Out-states into block_join: Materialized vs Pending → in_states_disagree,
//    but block_join ∉ uses_dst for order_copy (only a u64 block arg).
//    So no must_materialize_before_exit on block_read — dead join for dst.
// 5. O = { BeforeInst(store) } only. No edge CandidateSite. No coalesce of
//    multiple sites. Entry candidate removed; read arm stays copy-free.
//
// Expected:
//   A = entry mem_copy disappears,
//   B = copy in block_write just before the store,
//   C = block_read calls consume on the source argument directly,
//   D = nothing copied at the (dead) join.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_write(), block_read()

        block_write():
        v1 = get_local __ptr { u64, u64 }, order_copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B (first write: copy materializes just above this)
        v5 = get_local __ptr { u64, u64 }, order_copy
        v6 = call consume_read_only(v5) // Read of the now-private buffer.
        br block_join(v6)

        block_read():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_read_only(v7) // <------------------ C
        br block_join(v8)

        block_join(v9: u64): // <------------------ D
        ret u64 v9
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
