// SOUNDNESS: storing the *source* pointer captures it; bail (same as dst).
//
// Expected: entry `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy
        local mut __ptr { u64, u64 } slot

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ must stay
        v1 = get_local __ptr __ptr { u64, u64 }, slot
        store order to v1 // captures source pointer identity
        cbr flag, block_write(), block_join()

        block_write():
        v2 = get_local __ptr { u64, u64 }, order_copy
        v3 = const u64 1
        v4 = get_elem_ptr v2, __ptr u64, v3
        v5 = const u64 42
        store v5 to v4
        br block_join()

        block_join():
        v6 = get_local __ptr { u64, u64 }, order_copy
        v7 = call consume_read_only(v6)
        ret u64 v7
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
