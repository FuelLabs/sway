script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(mut flag: bool, order: __ptr { u64, u64 }):
        v4v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v4v1, order
        v6v1 = get_local __ptr { u64, u64 }, order_copy
        v7v1 = cmp eq v6v1 order
        cbr flag, block_write(), block_read()

        block_write():
        v9v1 = get_local __ptr { u64, u64 }, order_copy
        v10v1 = const u64 1
        v11v1 = get_elem_ptr v9v1, __ptr u64, v10v1
        v12v1 = const u64 42
        store v12v1 to v11v1
        v14v1 = get_local __ptr { u64, u64 }, order_copy
        v15v1 = call consume_read_only(v14v1)
        br block_join(v15v1)

        block_read():
        v17v1 = get_local __ptr { u64, u64 }, order_copy
        v18v1 = call consume_read_only(v17v1)
        br block_join(v18v1)

        block_join(v3v1: u64):
        ret u64 v3v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v22v1 = const u64 0
        v23v1 = get_elem_ptr order, __ptr u64, v22v1
        v24v1 = load v23v1
        ret u64 v24v1
    }
}
