script {
    entry fn main(order: __ptr { u64, u64 }) -> u64 {
        local mut u64 cursor
        local mut { u64, u64 } opt
        local mut { u64, u64 } order_copy

        entry(order: __ptr { u64, u64 }):
        v2v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v2v1, order
        v4v1 = get_local __ptr u64, cursor
        v5v1 = const u64 0
        store v5v1 to v4v1
        br while()

        while():
        v8v1 = get_local __ptr u64, cursor
        v9v1 = load v8v1
        v10v1 = get_local __ptr { u64, u64 }, opt
        v11v1 = call next(v9v1, v10v1)
        v12v1 = const u64 0
        v13v1 = get_elem_ptr v10v1, __ptr u64, v12v1
        v14v1 = load v13v1
        v15v1 = const u64 0
        v16v1 = cmp eq v14v1 v15v1
        cbr v16v1, while_body(), end_while()

        while_body():
        v18v1 = const u64 1
        v19v1 = get_elem_ptr v10v1, __ptr u64, v18v1
        v20v1 = load v19v1
        v21v1 = get_local __ptr { u64, u64 }, order_copy
        v22v1 = const u64 1
        v23v1 = get_elem_ptr v21v1, __ptr u64, v22v1
        store v20v1 to v23v1
        v25v1 = get_local __ptr u64, cursor
        v26v1 = load v25v1
        v27v1 = const u64 1
        v28v1 = add v26v1, v27v1
        store v28v1 to v25v1
        br while()

        end_while():
        v31v1 = get_local __ptr { u64, u64 }, order_copy
        v32v1 = call consume_read_only(v31v1)
        ret u64 v32v1
    }

    fn next(cursor: u64, out: __ptr { u64, u64 }) -> () {
        entry(mut cursor: u64, mut out: __ptr { u64, u64 }):
        v36v1 = const u64 3
        v37v1 = cmp lt cursor v36v1
        cbr v37v1, some(), none()

        some():
        v39v1 = const u64 0
        v40v1 = get_elem_ptr out, __ptr u64, v39v1
        v41v1 = const u64 0
        store v41v1 to v40v1
        v43v1 = const u64 1
        v44v1 = get_elem_ptr out, __ptr u64, v43v1
        store cursor to v44v1
        v46v1 = const unit ()
        ret () v46v1

        none():
        v48v1 = const u64 0
        v49v1 = get_elem_ptr out, __ptr u64, v48v1
        v50v1 = const u64 1
        store v50v1 to v49v1
        v52v1 = const unit ()
        ret () v52v1
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v55v1 = const u64 0
        v56v1 = get_elem_ptr order, __ptr u64, v55v1
        v57v1 = load v56v1
        ret u64 v57v1
    }
}
