// SOUNDNESS: a mutable use of `dst` *before* the candidate copy means an
// invisible alias may already exist; the pass must refuse the candidate.
//
// ```sway
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = Order { a: 0, prev: 0 };
//     poke_mut(order_copy); // MayWrite before the rebinding copy
//     order_copy = order;
//     if flag { order_copy.prev = 42; }
//     consume_read_only(order_copy)
// }
// ```
//
// Expected: the rebinding `mem_copy_val` stays put (bail).
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        v1 = call poke_mut(v0) // MayWrite before candidate
        v2 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v2, order // <------------------ must stay
        cbr flag, block_write(), block_fallthrough()

        block_write():
        v3 = get_local __ptr { u64, u64 }, order_copy
        v4 = const u64 1
        v5 = get_elem_ptr v3, __ptr u64, v4
        v6 = const u64 42
        store v6 to v5
        br block_join()

        block_fallthrough():
        br block_join()

        block_join():
        v7 = get_local __ptr { u64, u64 }, order_copy
        v8 = call consume_read_only(v7)
        ret u64 v8
    }

    fn poke_mut(order: __ptr { u64, u64 }) -> () {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = const u64 1
        store v2 to v1
        v3 = const unit ()
        ret () v3
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
