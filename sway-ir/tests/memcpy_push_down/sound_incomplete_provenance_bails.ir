// SOUNDNESS: dereferencing a pointer with incomplete provenance anywhere in
// the function makes aliasing unknowable; the candidate must be abandoned.
//
// Expected: entry `mem_copy_val` stays put.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64 }) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ must stay
        v1 = const u64 0
        v2 = int_to_ptr v1 to __ptr { u64, u64 }
        v3 = const u64 0
        v4 = get_elem_ptr v2, __ptr u64, v3
        v5 = const u64 7
        store v5 to v4 // Incomplete provenance store
        cbr flag, block_write(), block_read()

        block_write():
        v6 = get_local __ptr { u64, u64 }, order_copy
        v7 = const u64 1
        v8 = get_elem_ptr v6, __ptr u64, v7
        v9 = const u64 42
        store v9 to v8
        v10 = get_local __ptr { u64, u64 }, order_copy
        v11 = call consume_read_only(v10)
        br block_join(v11)

        block_read():
        v12 = get_local __ptr { u64, u64 }, order_copy
        v13 = call consume_read_only(v12)
        br block_join(v13)

        block_join(v14: u64):
        ret u64 v14
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
