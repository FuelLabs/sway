// Corresponding Sway (this hand-written IR mirrors its lowering):
//
// ```sway
// script;
//
// struct Order {
//     a: u64,
//     b: u64,
//     c: u64,
//     prev: u64,
// }
//
// fn main(flag: bool, order: Order) -> u64 {
//     let mut order_copy = order;
//     if flag {
//         order_copy.prev = 42;
//         order_copy.prev
//     } else {
//         order_copy.a
//     }
// }
// ```
//
// Expected from memcpy-push-down:
//   A = the entry `mem_copy_val` disappears,
//   B = a copy materializes in `block_write`, just before the store,
//   C = `block_read` loads field 0 from the source argument directly.
script {
    entry fn main(flag: bool, order: __ptr { u64, u64, u64, u64 }) -> u64 {
        local mut { u64, u64, u64, u64 } order_copy

        entry(flag: bool, order: __ptr { u64, u64, u64, u64 }):
        v0 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ A
        cbr flag, block_write(), block_read()

        block_write():
        v1 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v2 = const u64 3
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B (first write: copy materializes just above this)
        v5 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v6 = const u64 3
        v7 = get_elem_ptr v5, __ptr u64, v6
        v8 = load v7
        ret u64 v8

        block_read():
        v9 = get_local __ptr { u64, u64, u64, u64 }, order_copy
        v10 = const u64 0
        v11 = get_elem_ptr v9, __ptr u64, v10 // <--- C (re-based onto the source argument)
        v12 = load v11
        ret u64 v12
    }
}
