// SOUNDNESS: returning the destination pointer captures it; bail.
//
//
// ```sway
// script;
//
// struct Pair {
//     a: u64,
//     b: u64,
// }
//
// // Conceptual: return a pointer/reference to the copied local (capture).
// fn main(order: Pair) -> &mut Pair {
//     let mut order_copy = order;
//     &mut order_copy
// }
// ```
//
// Expected: entry `mem_copy_val` stays put.
script {
    entry fn main(order: __ptr { u64, u64 }) -> __ptr { u64, u64 } {
        local mut { u64, u64 } order_copy

        entry(order: __ptr { u64, u64 }):
        v0 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, order // <------------------ must stay
        v1 = get_local __ptr { u64, u64 }, order_copy
        ret __ptr { u64, u64 } v1
    }
}
