// CORRECTNESS: nested GEP (`order_copy.pair.x`) must be rebased onto the
// source when delegated, not left pointing at `order_copy`.
//
// ```sway
// struct Pair { x: u64, y: u64 }
// struct Wrap { pair: Pair, tag: u64 }
// fn main(flag: bool, w: Wrap) -> u64 {
//     let mut copy = w;
//     if flag {
//         copy.tag = 42;
//         copy.pair.x
//     } else {
//         copy.pair.x
//     }
// }
// ```
//
// Expected:
//   A = entry copy disappears,
//   B = copy materializes before the store to `tag`,
//   C = read arm loads `pair.x` from `w` (nested GEP on the source).
script {
    entry fn main(flag: bool, w: __ptr { { u64, u64 }, u64 }) -> u64 {
        local mut { { u64, u64 }, u64 } copy

        entry(flag: bool, w: __ptr { { u64, u64 }, u64 }):
        v0 = get_local __ptr { { u64, u64 }, u64 }, copy
        mem_copy_val v0, w // <------------------ A
        cbr flag, block_write(), block_read()

        block_write():
        v1 = get_local __ptr { { u64, u64 }, u64 }, copy
        v2 = const u64 1
        v3 = get_elem_ptr v1, __ptr u64, v2
        v4 = const u64 42
        store v4 to v3 // <------------------ B
        v5 = get_local __ptr { { u64, u64 }, u64 }, copy
        v6 = const u64 0
        v7 = get_elem_ptr v5, __ptr { u64, u64 }, v6
        v8 = const u64 0
        v9 = get_elem_ptr v7, __ptr u64, v8
        v10 = load v9
        ret u64 v10

        block_read():
        v11 = get_local __ptr { { u64, u64 }, u64 }, copy
        v12 = const u64 0
        v13 = get_elem_ptr v11, __ptr { u64, u64 }, v12
        v14 = const u64 0
        v15 = get_elem_ptr v13, __ptr u64, v14 // <------------------ C
        v16 = load v15
        ret u64 v16
    }
}
