// FILTER: self-copy (`dst == src` symbol) is not a candidate.
//
//
// ```sway
// script;
//
// struct Pair {
//     a: u64,
//     b: u64,
// }
//
// #[inline(never)]
// fn consume_read_only(order: Pair) -> u64 {
//     order.a
// }
//
// fn main(flag: bool) -> u64 {
//     let mut order_copy = Pair { a: 0, b: 0 };
//     order_copy = order_copy; // self-copy (IR: mem_copy_val same symbol)
//     if flag {
//         order_copy.b = 42;
//         consume_read_only(order_copy)
//     } else {
//         consume_read_only(order_copy)
//     }
// }
// ```
//
// Expected: Modified: false.
script {
    entry fn main(flag: bool) -> u64 {
        local mut { u64, u64 } order_copy

        entry(flag: bool):
        v0 = get_local __ptr { u64, u64 }, order_copy
        v1 = get_local __ptr { u64, u64 }, order_copy
        mem_copy_val v0, v1
        cbr flag, block_write(), block_read()

        block_write():
        v2 = get_local __ptr { u64, u64 }, order_copy
        v3 = const u64 1
        v4 = get_elem_ptr v2, __ptr u64, v3
        v5 = const u64 42
        store v5 to v4
        v6 = get_local __ptr { u64, u64 }, order_copy
        v7 = call consume_read_only(v6)
        br block_join(v7)

        block_read():
        v8 = get_local __ptr { u64, u64 }, order_copy
        v9 = call consume_read_only(v8)
        br block_join(v9)

        block_join(v10: u64):
        ret u64 v10
    }

    fn consume_read_only(order: __ptr { u64, u64 }) -> u64 {
        entry(order: __ptr { u64, u64 }):
        v0 = const u64 0
        v1 = get_elem_ptr order, __ptr u64, v0
        v2 = load v1
        ret u64 v2
    }
}
