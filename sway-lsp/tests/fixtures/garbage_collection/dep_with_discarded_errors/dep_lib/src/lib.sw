library;

/// `raw_slice` does not implement the `Debug` trait, so the attempt to
/// auto-implement `Debug` for this struct fails, and the errors emitted
/// during that attempt get discarded. This gives us a dependency whose
/// every compilation discards errors coming from autogenerated code.
pub struct SliceWrapper {
    pub slice: raw_slice,
    pub ptr: raw_ptr,
    pub len: u64,
}

impl SliceWrapper {
    pub fn empty() -> Self {
        let ptr = asm() {
            hp: raw_ptr
        };
        Self {
            slice: raw_slice::from_parts::<u8>(ptr, 0),
            ptr,
            len: 0,
        }
    }
}

pub fn wrapped_len(wrapper: SliceWrapper) -> u64 {
    wrapper.len
}
